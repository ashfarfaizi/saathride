# Copy to .env (never commit .env). Get DATABASE_URL from the Neon dashboard -> Connect.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Long random string, e.g. run:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Photo uploads (Cloudinary). Leave blank to run without photos: posting still works, the UI says uploads are off.
# Cloudinary dashboard -> Settings -> API Keys. The API secret stays on the server and is never sent to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional (defaults to Asia/Kolkata): used to decide what "today" means for the feed
# APP_TIMEZONE=Asia/Kolkata

# Optional: in-app voice calls (LiveKit). Leave blank and messaging still works; the call button just stays hidden.
# LiveKit Cloud -> your project -> Settings -> API Keys. The secret stays on the server; browsers only get short-lived room tokens.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: maps, place search and route matching (Mapbox). Without it posting/matching still work by place name.
# account.mapbox.com -> Tokens. A public token (starts with pk.) — restrict it to your site's URLs in Mapbox.
MAPBOX_TOKEN=
# Optional: a separate URL-restricted public token for the browser map (defaults to MAPBOX_TOKEN if that starts with pk.)
# MAPBOX_PUBLIC_TOKEN=
# MAPBOX_COUNTRY=in

# Optional: Saath AI (Claude API). Without it Saath AI runs in a simpler "basic mode".
# console.anthropic.com -> API Keys. Server-side only — never put it in frontend code.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5
# Petrol price used for cost-share estimates (₹/litre)
# FUEL_PRICE_INR=104

# Optional: comma-separated emails allowed to review reports at /#/admin
# ADMIN_EMAILS=you@example.com

